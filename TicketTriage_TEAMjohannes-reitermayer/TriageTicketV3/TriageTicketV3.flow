    {
      "id": "draftSupportKb",
      "type": "uipath.agent.resource.context.index.supportkb.e47fcbe5-bd8b-47fa-29dc-08df04e92605",
      "typeVersion": "1.0.0",
      "display": {
        "label": "SupportKB",
        "icon": "context"
      },
      "inputs": {
        "source": "0061b46f-bb8e-4c6d-acad-ea79c828752f"
      }
    },
    {
      "id": "checkSafetyGate",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Safety Gate (deterministic)",
        "icon": "code"
      },
      "inputs": {
        "script": "// Deterministic safety gate for TriageTicketV3 (runs right after classifyAndDraft).\n// The agent's kbCovered / kbSources / kbGaps are claims, not proof. A ticket only\n// becomes an auto-resolve candidate when every check below passes; anything\n// missing, malformed, or unexpected fails closed to human review. Candidates are\n// then re-checked by the independent verifyGrounding agent before anything is sent.\nconst out = $vars.classifyAndDraft.output || {};\n\n// The 14 SupportKB articles (bucket SupportKBDocs, Shared folder) as of 2026-09-13.\n// A citation outside this list blocks auto-resolve, so adding an article only\n// costs autonomy until this list is updated; it can never let a ticket through.\nconst KB_DOCS = [\n  'kb-01-password-reset', 'kb-02-vpn-setup', 'kb-03-expense-reports', 'kb-04-mfa-enrollment',\n  'kb-05-software-requests', 'kb-06-email-signature', 'kb-07-printers', 'kb-08-guest-wifi',\n  'kb-09-laptop-hardware', 'kb-10-phishing', 'kb-11-onboarding', 'kb-12-meeting-rooms',\n  'kb-13-hr-portal-access', 'kb-14-service-desk'\n];\nconst AUTO_CATEGORIES = ['access', 'hardware', 'software', 'network', 'billing', 'other'];\nconst AUTO_PRIORITIES = ['low', 'medium'];\nconst URGENT_PRIORITIES = ['critical', 'high', 'urgent'];\nconst NOISE_MIN_CONFIDENCE = 0.8;\nconst AUTO_MIN_CONFIDENCE = 0.85;\n// A reply that escalates, promises follow-up, or leaks internal tooling is not a\n// resolution, whatever the flags say. Matched case-insensitively on the draft.\nconst BLOCKED_DRAFT_PHRASES = [\n  'escalat', 'specialist', 'on-call', 'get back to you', 'follow up with you', 'look into',\n  'supportkb', 'knowledge base', 'helpdesk article', 'runbook', 'published article',\n  \"i don't have\", 'i do not have', \"we don't have\", 'we do not have',\n  'unable to confirm', 'cannot confirm', \"can't confirm\",\n  '[', ']', '{' + '{', '}' + '}', 'placeholder', 'tbd'  // braces split: the validator flags literal mustaches\n];\n\nconst text = v => (typeof v === 'string' ? v.trim() : '');\nconst lower = v => text(v).toLowerCase();\nconst strictTrue = v => v === true || lower(v) === 'true';\nconst strictFalse = v => v === false || lower(v) === 'false';\nconst toNumber = v => {\n  if (typeof v === 'number') return v;\n  const s = text(v);\n  return s !== '' && !isNaN(Number(s)) ? Number(s) : NaN;\n};\nconst toList = v => (Array.isArray(v) ? v.map(x => text(x)).filter(x => x.length > 0) : null);\n// Accepts \"kb-01-password-reset\", \"kb-01-password-reset.txt\", \"kb-01\" or a path;\n// anything else (a title, a URL, an invented article) is not a citation.\nconst canonicalDoc = s => {\n  const name = s.toLowerCase().split('/').pop().split('\\\\').pop().trim();\n  const i = name.indexOf('kb-');\n  if (i !== 0) return null;\n  const prefix = name.substring(0, 5);\n  const doc = KB_DOCS.find(d => d.startsWith(prefix)) || null;\n  const rest = name.replace('.txt', '');\n  return doc && (rest === prefix || rest === doc) ? doc : null;\n};\n\nconst category = lower(out.category);\nconst priority = lower(out.priority);\nconst confidence = toNumber(out.confidence);\nconst kbSources = toList(out.kbSources);\nconst kbGaps = toList(out.kbGaps);\nconst draft = text(out.draftReply);\nconst draftForMatching = draft.toLowerCase().split('’').join(\"'\");\nconst kbSourcesText = kbSources && kbSources.length ? kbSources.join(', ') : '(none)';\nconst kbGapsText = kbGaps === null ? '(not reported)' : (kbGaps.length ? kbGaps.join('; ') : '(none)');\n\nlet route;\nconst failures = [];\nif (category === 'noise' && confidence >= NOISE_MIN_CONFIDENCE) {\n  route = 'noise';\n} else if (URGENT_PRIORITIES.includes(priority)) {\n  route = 'urgent';\n  failures.push('priority is ' + (text(out.priority) || '(missing)') + '; urgent tickets always get a human');\n} else {\n  if (!AUTO_CATEGORIES.includes(category)) failures.push('category \"' + text(out.category) + '\" is not auto-resolvable');\n  if (!AUTO_PRIORITIES.includes(priority)) failures.push('priority \"' + text(out.priority) + '\" is not Low or Medium');\n  if (!(confidence >= AUTO_MIN_CONFIDENCE && confidence <= 1)) failures.push('confidence ' + (isNaN(confidence) ? '(missing)' : confidence) + ' is below ' + AUTO_MIN_CONFIDENCE);\n  if (!strictTrue(out.kbCovered)) failures.push('agent did not mark the ticket as fully covered by SupportKB (kbCovered=' + JSON.stringify(out.kbCovered) + ')');\n  if (kbGaps === null) failures.push('agent did not report kbGaps');\n  else if (kbGaps.length) failures.push('agent flagged KB gaps: ' + kbGapsText);\n  if (!strictFalse(out.needsStaffAction)) failures.push('resolution needs staff action (needsStaffAction=' + JSON.stringify(out.needsStaffAction) + ')');\n  if (kbSources === null || kbSources.length === 0) failures.push('no SupportKB sources cited');\n  else {\n    const unknown = kbSources.filter(s => canonicalDoc(s) === null);\n    if (unknown.length) failures.push('cited sources that are not SupportKB articles: ' + unknown.join(', '));\n  }\n  if (!draft) failures.push('draft reply is empty');\n  else {\n    const hits = BLOCKED_DRAFT_PHRASES.filter(p => draftForMatching.includes(p));\n    if (hits.length) failures.push('draft contains wording that is not a self-contained answer: ' + hits.map(h => '\"' + h + '\"').join(', '));\n  }\n  route = failures.length ? 'review' : 'verify';\n}\n\nconst citedKbDocs = (kbSources || []).map(canonicalDoc).filter(d => d !== null)\n  .filter((d, i, all) => all.indexOf(d) === i);\n\nreturn {\n  route: route,\n  autoResolveCandidate: route === 'verify',\n  gateFailures: failures,\n  gateSummary: route === 'noise' ? 'Auto-skipped: automated noise (confidence ' + confidence + ')'\n    : route === 'verify' ? 'Passed the deterministic gate; sent to the independent grounding check'\n    : 'Not auto-resolved: ' + failures.join(' | '),\n  kbCovered: strictTrue(out.kbCovered) && kbGaps !== null && kbGaps.length === 0,\n  kbSourcesText: kbSourcesText,\n  kbGapsText: kbGapsText,\n  citedKbDocs: citedKbDocs.join(', ')\n};\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Route (noise, urgent, verify, review), gate failures, and KB citation summary",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "routeTicket",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Route by gate result",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "noise",
            "label": "Noise: auto-skip",
            "expression": "$vars.checkSafetyGate.output.route === 'noise'"
          },
          {
            "id": "urgent",
            "label": "Critical / High: urgent review",
            "expression": "$vars.checkSafetyGate.output.route === 'urgent'"
          },
          {
            "id": "verify",
            "label": "KB-covered candidate: verify grounding",
            "expression": "$vars.checkSafetyGate.output.route === 'verify' && $vars.checkSafetyGate.output.autoResolveCandidate === true"
          }
        ]
      },
      "outputs": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched case",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The ID of the matched case (\"default\" for the default branch)",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "verifyGrounding",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Verify Draft Against SupportKB",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "source": "8f46a36b-9558-41a7-a053-a889f8c4de25",
        "agentInputVariables": [
          {
            "id": "start__output__subject",
            "type": "string",
            "binding": "=$vars.start.output.subject",
            "description": "Bound from $vars.start.output.subject"
          },
          {
            "id": "start__output__body",
            "type": "string",
            "binding": "=$vars.start.output.body",
            "description": "Bound from $vars.start.output.body"
          },
          {
            "id": "classifyAndDraft__output__draftReply",
            "type": "string",
            "binding": "=$vars.classifyAndDraft.output.draftReply",
            "description": "Bound from $vars.classifyAndDraft.output.draftReply"
          },
          {
            "id": "checkSafetyGate__output__citedKbDocs",
            "type": "string",
            "binding": "=$vars.checkSafetyGate.output.citedKbDocs",
            "description": "Bound from $vars.checkSafetyGate.output.citedKbDocs"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "draftGrounded",
            "type": "boolean"
          },
          {
            "id": "answersEveryQuestion",
            "type": "boolean"
          },
          {
            "id": "unsupportedClaims",
            "type": "array"
          },
          {
            "id": "unansweredQuestions",
            "type": "array"
          },
          {
            "id": "verdictNotes",
            "type": "string"
          }
        ]
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Agent response",
          "var": "output",
          "properties": {
            "draftGrounded": {
              "type": "boolean"
            },
            "answersEveryQuestion": {
              "type": "boolean"
            },
            "unsupportedClaims": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "unansweredQuestions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "verdictNotes": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "verifySupportKb",
      "type": "uipath.agent.resource.context.index.supportkb.e47fcbe5-bd8b-47fa-29dc-08df04e92605",
      "typeVersion": "1.0.0",
      "display": {
        "label": "SupportKB",
        "icon": "context"
      },
      "inputs": {
        "source": "b9feb5ee-91b1-4414-a9e4-39a1b2dba95c"
      }
    },
    {
      "id": "checkVerification",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "Grounding Check (deterministic)",
        "icon": "code"
      },
      "inputs": {
        "script": "// Second, independent check (runs only for gate candidates, after verifyGrounding).\n// The verifier did not write the draft; it re-searches SupportKB and must confirm\n// every claim and every customer question. Both lists must be reported and empty,\n// and both booleans strictly true, or the ticket goes to human review.\nconst v = $vars.verifyGrounding.output || {};\n\nconst text = x => (typeof x === 'string' ? x.trim() : '');\nconst strictTrue = x => x === true || text(x).toLowerCase() === 'true';\nconst toList = x => (Array.isArray(x) ? x.map(i => text(i)).filter(i => i.length > 0) : null);\n\nconst unsupported = toList(v.unsupportedClaims);\nconst unanswered = toList(v.unansweredQuestions);\nconst failures = [];\nif (!strictTrue(v.draftGrounded)) failures.push('verifier did not confirm the draft is grounded (draftGrounded=' + JSON.stringify(v.draftGrounded) + ')');\nif (!strictTrue(v.answersEveryQuestion)) failures.push('verifier did not confirm every question is answered (answersEveryQuestion=' + JSON.stringify(v.answersEveryQuestion) + ')');\nif (unsupported === null) failures.push('verifier did not report unsupportedClaims');\nelse if (unsupported.length) failures.push('claims not found in SupportKB: ' + unsupported.join('; '));\nif (unanswered === null) failures.push('verifier did not report unansweredQuestions');\nelse if (unanswered.length) failures.push('questions the draft does not answer: ' + unanswered.join('; '));\n\nreturn {\n  verified: failures.length === 0,\n  verificationFailures: failures,\n  verificationSummary: failures.length === 0\n    ? 'Auto-resolved: deterministic gate passed and independent verifier confirmed every claim against SupportKB. ' + text(v.verdictNotes)\n    : 'Grounding check failed: ' + failures.join(' | ') + (text(v.verdictNotes) ? ' | Verifier notes: ' + text(v.verdictNotes) : '')\n};\n"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Whether the independent verifier confirmed the draft, with failure reasons",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "autoResolveDecision",
      "type": "core.logic.switch",
      "typeVersion": "1.1",
      "display": {
        "label": "Auto-resolve only if verified",
        "icon": "between-horizontal-start"
      },
      "inputs": {
        "cases": [
          {
            "id": "verified",
            "label": "Verified: auto-resolve",
            "expression": "$vars.checkVerification.output.verified === true"
          }
        ]
      },
      "outputs": {
        "matchedCase": {
          "type": "string",
          "description": "The label of the matched case",
          "var": "matchedCase"
        },
        "matchedCaseId": {
          "type": "string",
          "description": "The ID of the matched case (\"default\" for the default branch)",
          "var": "matchedCaseId"
        }
      }
    },
    {
      "id": "urgentReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.1",
      "display": {
        "label": "Urgent Review",
        "icon": "users"
      },
      "inputs": {
        "title": "URGENT: Review Draft Reply (Critical/High impact)",
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user",
            "value": "user@example.com"
          }
        },
        "priority": "High",
        "schema": {
          "schemaId": "78caf8dd-1b02-45a4-88dc-37a0e8df8246",
          "fields": [
            {
              "id": "priority",
              "label": "Priority",
              "type": "string",
              "direction": "input",
              "binding": "vars.classifyAndDraft.output.priority"
            },
            {
              "id": "recommendedapproach",
              "label": "Recommended Approach (for reviewer)",
              "type": "string",
              "direction": "input",
              "binding": "vars.classifyAndDraft.output.recommendedApproach"
            },
            {
              "id": "ticketid",
              "label": "Ticket ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.ticketId"
            },
            {
              "id": "customername",
              "label": "Customer Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.customerName"
            },
            {
              "id": "subject",
              "label": "Subject",
              "type": "string",
              "direction": "input",
              "binding": "vars.subject"
            },
            {
              "id": "body",
              "label": "Ticket Body",
              "type": "string",
              "direction": "input",
              "binding": "vars.body"
            },
            {
              "id": "autonomygate",
              "label": "Why this was not auto-resolved",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkSafetyGate.output.gateSummary"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.classifyAndDraft.output.category"
            },
            {
              "id": "confidence",
              "label": "Confidence",
              "type": "number",
              "direction": "input",
              "binding": "vars.classifyAndDraft.output.confidence"
            },
            {
              "id": "rationale",
              "label": "Agent Rationale",
              "type": "string",
              "direction": "input",
              "binding": "vars.classifyAndDraft.output.rationale"
            },
            {
              "id": "kbsources",
              "label": "SupportKB Sources Cited",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkSafetyGate.output.kbSourcesText"
            },
            {
              "id": "kbgaps",
              "label": "KB Gaps Flagged by the Agent",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkSafetyGate.output.kbGapsText"
            },
            {
              "id": "draftreply",
              "label": "Draft Reply (sent to the customer; edit before Modify & Send)",
              "type": "string",
              "direction": "inOut",
              "binding": "vars.classifyAndDraft.output.draftReply",
              "variable": "vars.urgentDraftReply"
            },
            {
              "id": "reviewernote",
              "label": "Reviewer Note (internal, never sent to the customer)",
              "type": "string",
              "direction": "output",
              "variable": "vars.urgentReviewerNote"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "modifyandsend",
              "name": "Modify & Send",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "draftreply": {
              "type": "string"
            },
            "reviewernote": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Modify & Send",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Modify & Send",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "standardReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.1",
      "display": {
        "label": "Standard Review",
        "icon": "users"
      },
      "inputs": {
        "title": "Review Draft Reply",
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user",
            "value": "user@example.com"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "a0ff1606-e84f-4fe3-9e34-582c15489863",
          "fields": [
            {
              "id": "autonomygate",
              "label": "Why this was not auto-resolved",
              "type": "string",
              "direction": "input",
              "binding": "vars.checkSafetyGate.output.gateSummary"
            },
            {
              "id": "recommendedapproach",
              "label": "Recommended Approach (for reviewer)",
              "type": "string",
              "direction": "input",
              "binding": "vars.classifyAndDraft.output.recommendedApproach"
            },
            {
              "id": "ticketid",
              "label": "Ticket ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.ticketId"
            },
            {
