              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              },
              "label": "Approve"
            },
            {
              "id": "outcome-modifyandsend",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              },
              "label": "Modify & Send"
            },
            {
              "id": "outcome-reject",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              },
              "label": "Reject"
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "inputDefaults": {
        "schema": {
          "fields": [],
          "outcomes": [
            {
              "id": "submit",
              "name": "Submit",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            }
          ]
        },
        "recipient": {
          "channels": [
            "Email",
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "group"
          }
        }
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output"
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": "=result.Action",
          "var": "status"
        }
      },
      "form": {
        "id": "hitl-quick-form-properties",
        "title": "Quick Form Task Configuration",
        "sections": [
          {
            "id": "delivery",
            "title": "Task delivery",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.recipient",
                "type": "custom",
                "component": "hitl-channel-selector",
                "label": "Delivery Channels",
                "description": "Select where the task should be sent"
              }
            ]
          },
          {
            "id": "schema",
            "title": "Schema",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.schema",
                "type": "custom",
                "component": "hitl-schema-editor",
                "label": "Task Schema",
                "description": "Define the input and output parameters for this task"
              }
            ]
          },
          {
            "id": "additional-properties",
            "title": "Additional properties",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.title",
                "type": "text",
                "label": "Task title"
              },
              {
                "name": "inputs.priority",
                "type": "select",
                "label": "Priority",
                "options": [
                  {
                    "label": "Low",
                    "value": "Low"
                  },
                  {
                    "label": "Medium",
                    "value": "Medium"
                  },
                  {
                    "label": "High",
                    "value": "High"
                  }
                ]
              },
              {
                "name": "inputs.labels",
                "type": "text",
                "label": "Labels",
                "placeholder": "Comma-separated (e.g. finance,approval)"
              },
              {
                "name": "inputs.memorySpace",
                "type": "custom",
                "component": "hitl-memory-space-picker",
                "label": "Memory space",
                "description": "Attach a memory space so this task's inputs and outputs are written to it"
              }
            ]
          }
        ]
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a process path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 66,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      },
      "runtimeConstraints": {
        "exclude": [
          "api-function"
        ]
      }
    }
  ],
  "runtime": "maestro",
