      },
      {
        "id": "decision",
        "direction": "out",
        "type": "string",
        "description": "AutoSkipped (noise), AutoResolved (KB-verified, no human), or the reviewer outcome: Approve, Modify & Send, Reject"
      },
      {
        "id": "finalReply",
        "direction": "out",
        "type": "string",
        "description": "Reply to send: the verified draft for AutoResolved, the approved or edited draft after review, empty after Reject, a fixed marker for auto-skipped noise"
      },
      {
        "id": "category",
        "direction": "out",
        "type": "string",
        "description": "Ticket category assigned by the agent (includes Noise)"
      },
      {
        "id": "priority",
        "direction": "out",
        "type": "string",
        "description": "Ticket priority assigned by the agent"
      },
      {
        "id": "recommendedApproach",
        "direction": "out",
        "type": "string",
        "description": "Agent guidance to the reviewer on the next action"
      },
      {
        "id": "reviewerNote",
        "direction": "out",
        "type": "string",
        "description": "Internal note from the reviewer; empty when no human reviewed the ticket"
      },
      {
        "id": "kbCovered",
        "direction": "out",
        "type": "boolean",
        "description": "true only if the agent reported full SupportKB coverage with no gaps"
      },
      {
        "id": "kbSources",
        "direction": "out",
        "type": "string",
        "description": "SupportKB article ids the agent cited"
      },
      {
        "id": "autonomyGate",
        "direction": "out",
        "type": "string",
        "description": "Why the ticket was or was not auto-resolved (gate and verifier findings)"
