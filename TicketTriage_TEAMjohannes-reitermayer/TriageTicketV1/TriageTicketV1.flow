            "type": "string",
            "minLength": 1,
            "errorMessage": {
              "minLength": "Model is required"
            }
          },
          "mode": {
            "type": "string",
            "enum": [
              "standard",
              "advanced"
            ]
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxTokenPerResponse": {
            "type": "number",
            "minimum": 0
          },
          "modelMaxTokens": {
            "type": "number",
            "minimum": 0
          },
          "maxIterations": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
          },
          "guardrails": {
            "type": "array"
          },
          "agentInputVariables": {
            "type": "array"
          },
          "agentOutputVariables": {
            "type": "array"
          }
        },
        "required": [
          "systemPrompt",
          "userPrompt",
          "model"
        ]
      },
