{
  "id": "d76a4577-a189-481a-9b6b-1b07d9f6398e",
  "version": "1.9",
  "name": "TriageTicketV1",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "start",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "Support ticket received",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "21ba14cd-783d-421a-ba44-3c7da1efc322",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      }
    },
    {
      "id": "triageAgent1",
      "type": "uipath.agent.autonomous",
      "typeVersion": "1.4",
      "display": {
        "label": "Classify & Draft Reply",
        "icon": "autonomous-agent"
      },
      "inputs": {
        "systemPrompt": "You are a support ticket triage specialist for HomeFix Supply's IT helpdesk. For one incoming ticket you do exactly two things: classify it, and draft a reply the customer could receive as-is once a human approves it.\n\nGrounding\nThe SupportKB context handle is your only source of product and policy knowledge. Search it for the specific problem described in the ticket before you write anything. Never state a setting, policy, entitlement, timeline, or troubleshooting step that you did not find in SupportKB. Do not fill gaps from general knowledge.\n\nCall SupportKB at most 3 times for this ticket. After the last call, stop retrieving and decide with the evidence you already have.\nIf the retrieved content does not cover a detail the customer asked about, say so in rationale, lower confidence, and still return every outputSchema field. Never end a run without a determination.\n\nClassification\ncategory is the nature of the problem and must be exactly one of: Access (logins, passwords, MFA, permissions), Hardware (physical devices, peripherals), Software (applications, installs, licences, errors), Network (connectivity, VPN, Wi-Fi), Billing (invoices, charges, subscriptions), Other (anything that fits none of the above).\npriority reflects business impact and blast radius, not the customer's tone, and must be exactly one of: Critical (many users blocked or a security incident), High (one user fully blocked with no workaround), Medium (degraded but workable, or a workaround exists), Low (a question, a request, or a cosmetic issue).\n\nDraft reply\nWrite draftReply as the complete message body only. No subject line, no placeholder brackets, no \"[insert X here]\". Open by addressing the customer by their name. Acknowledge the specific problem in their own terms. Give the concrete steps or answer that SupportKB supports, numbered when there is more than one. If SupportKB does not cover the issue, say plainly that you are escalating it to a specialist rather than inventing a fix. Close courteously and sign off as the HomeFix Supply Support Team. Keep it under 200 words in a professional, plain-spoken tone.\n\nOutput contract\nReturn every field of the output schema on every run: category, priority, draftReply, rationale, confidence. A human reviewer reads your output next and will approve, edit, or reject the draft. Write rationale for that reviewer in at most three sentences, and set confidence honestly so a low score signals that the draft needs their attention.",
        "userPrompt": "Triage this support ticket.\n\nTicket ID: {{ $vars.start.output.ticketId }}\nCustomer name: {{ $vars.start.output.customerName }}\nSubject: {{ $vars.start.output.subject }}\n\nBody:\n{{ $vars.start.output.body }}",
        "model": "gpt-5.5-2026-04-23",
        "mode": "standard",
        "temperature": 0,
        "maxTokenPerResponse": 128000,
        "maxIterations": 25,
        "isConversational": false,
        "guardrails": [],
        "name": "Classify & Draft Reply",
        "agentInputVariables": [
          {
            "id": "start__output__ticketId",
            "type": "string",
            "binding": "=$vars.start.output.ticketId",
            "description": "Bound from $vars.start.output.ticketId"
          },
          {
            "id": "start__output__subject",
            "type": "string",
            "binding": "=$vars.start.output.subject",
            "description": "Bound from $vars.start.output.subject"
          },
          {
            "id": "start__output__body",
            "type": "string",
            "binding": "=$vars.start.output.body",
            "description": "Bound from $vars.start.output.body"
          },
          {
            "id": "start__output__customerName",
            "type": "string",
            "binding": "=$vars.start.output.customerName",
            "description": "Bound from $vars.start.output.customerName"
          }
        ],
        "agentOutputVariables": [
          {
            "id": "category",
            "type": "string"
          },
          {
            "id": "priority",
            "type": "string"
          },
          {
            "id": "draftReply",
            "type": "string"
          },
          {
            "id": "rationale",
            "type": "string"
          },
          {
            "id": "confidence",
            "type": "number"
          }
        ],
        "source": "38b67540-ed7d-4b12-993c-a8e55aeab6e2"
      },
      "outputs": {
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error"
        }
      }
    },
    {
      "id": "supportKbContext1",
      "type": "uipath.agent.resource.context.index.supportkb.e47fcbe5-bd8b-47fa-29dc-08df04e92605",
      "typeVersion": "1.0.0",
      "display": {
        "label": "SupportKB",
        "icon": "context"
      },
      "inputs": {
        "source": "b933812c-2231-4a56-8f6f-3c771b08e559",
        "id": "supportKbContext1",
        "name": "SupportKB",
        "description": "HomeFix Supply IT helpdesk knowledge base (14 articles) for the Fusion Triage Lab",
        "referenceKey": "",
        "indexName": "SupportKB",
        "folderPath": "Shared",
        "resultCount": 5,
        "threshold": 0,
        "retrievalMode": "semantic",
        "query": {
          "mode": "prompt",
          "textValue": "",
          "promptValue": "The support problem described in the ticket, phrased as a knowledge base search query",
          "argumentPath": ""
        },
        "fileExtension": "All",
        "folderPathPrefix": {
          "mode": "text-builder",
          "textValue": "",
          "promptValue": "",
          "argumentPath": ""
        }
      }
    },
    {
      "id": "reviewDraftReply1",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.6",
      "display": {
        "label": "Review Draft Reply",
        "icon": "users"
      },
      "inputs": {
        "title": "Review Draft Reply",
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user",
            "value": "user@example.com"
          }
        },
        "priority": "Medium",
        "schema": {
          "schemaId": "757f844a-924f-4460-93eb-27e2ede2744a",
          "fields": [
            {
              "id": "ticketid",
              "label": "Ticket ID",
              "type": "string",
              "direction": "input",
              "binding": "vars.ticketId"
            },
            {
              "id": "customername",
              "label": "Customer Name",
              "type": "string",
              "direction": "input",
              "binding": "vars.customerName"
            },
            {
              "id": "subject",
              "label": "Subject",
              "type": "string",
              "direction": "input",
              "binding": "vars.subject"
            },
            {
              "id": "body",
              "label": "Ticket Body",
              "type": "string",
              "direction": "input",
              "binding": "vars.body"
            },
            {
              "id": "category",
              "label": "Category",
              "type": "string",
              "direction": "input",
              "binding": "vars.triageAgent1.output.category"
            },
            {
              "id": "priority",
              "label": "Priority",
              "type": "string",
              "direction": "input",
              "binding": "vars.triageAgent1.output.priority"
            },
            {
              "id": "rationale",
              "label": "Agent Rationale",
              "type": "string",
              "direction": "input",
              "binding": "vars.triageAgent1.output.rationale"
            },
            {
              "id": "confidence",
              "label": "Confidence",
              "type": "number",
              "direction": "input",
              "binding": "vars.triageAgent1.output.confidence"
            },
            {
              "id": "draftreply",
              "label": "Draft Reply",
              "type": "string",
              "direction": "inOut",
              "binding": "vars.triageAgent1.output.draftReply",
              "variable": "vars.draftReply"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "modifyandsend",
              "name": "Modify & Send",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        }
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": "=result",
          "var": "output",
          "properties": {
            "draftreply": {
              "type": "string"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Modify & Send",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status",
          "source": "=result.Action",
          "var": "status",
          "enum": [
            "Approve",
            "Modify & Send",
            "Reject"
          ],
          "default": "Approve"
        }
      }
    },
    {
      "id": "end1",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Decision Recorded",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "decision": {
          "source": "=js:$vars.reviewDraftReply1.status",
          "type": "string"
        },
        "finalReply": {
          "source": "=js:$vars.reviewDraftReply1.output.draftreply",
          "type": "string"
        },
        "category": {
          "source": "=js:$vars.triageAgent1.output.category",
          "type": "string"
        },
        "priority": {
          "source": "=js:$vars.triageAgent1.output.priority",
          "type": "string"
        }
      }
    }
  ],
