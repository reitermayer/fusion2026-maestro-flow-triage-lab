    {
      "id": "decisionRecorded",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Decision Recorded",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "decision": {
          "type": "string",
          "source": "=js:(String($vars.classifyAndDraft.output.category || '').trim().toLowerCase() === 'noise' && Number($vars.classifyAndDraft.output.confidence) >= 0.8) ? \"AutoSkipped\" : ((['critical', 'high', 'urgent'].indexOf(String($vars.classifyAndDraft.output.priority || '').trim().toLowerCase()) !== -1) ? $vars.urgentReview.status : $vars.standardReview.status)"
        },
        "finalReply": {
          "type": "string",
          "source": "=js:(String($vars.classifyAndDraft.output.category || '').trim().toLowerCase() === 'noise' && Number($vars.classifyAndDraft.output.confidence) >= 0.8) ? \"None - Auto-reply noise filtered\" : ((['critical', 'high', 'urgent'].indexOf(String($vars.classifyAndDraft.output.priority || '').trim().toLowerCase()) !== -1) ? $vars.urgentReview.output.draftreply : $vars.standardReview.output.draftreply)"
        },
        "category": {
          "type": "string",
          "source": "=js:$vars.classifyAndDraft.output.category"
        },
        "priority": {
          "type": "string",
          "source": "=js:$vars.classifyAndDraft.output.priority"
        },
        "recommendedApproach": {
          "type": "string",
          "source": "=js:$vars.classifyAndDraft.output.recommendedApproach"
        },
        "reviewerNote": {
          "type": "string",
          "source": "=js:(String($vars.classifyAndDraft.output.category || '').trim().toLowerCase() === 'noise' && Number($vars.classifyAndDraft.output.confidence) >= 0.8) ? \"\" : ((['critical', 'high', 'urgent'].indexOf(String($vars.classifyAndDraft.output.priority || '').trim().toLowerCase()) !== -1) ? ($vars.urgentReview.output.reviewernote || \"\") : ($vars.standardReview.output.reviewernote || \"\"))"
        }
      }
    }
  ],
